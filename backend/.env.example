# Configuración del backend Django de PyGo.
#
# Plantilla: copia este fichero a backend/.env y rellena los valores.
#
# OJO: en este proyecto `backend/.env` SÍ está versionado a propósito (lo dice
# backend/.gitignore), al revés de lo que decía antes este comentario. Es decir:
# la service-role key, que da acceso completo a la base de datos saltándose RLS,
# está en el historial de git. Si el repo se hace público o se comparte, esa
# clave hay que rotarla desde el dashboard de Supabase.
#
# Por eso SUPABASE_DB_PASSWORD se deja vacía aquí y en el .env real: migrar_sql
# la pide por teclado y así no acaba en un fichero versionado.

# --- Supabase (obligatorio) -------------------------------------------------
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
SUPABASE_TIMEOUT_SECONDS=15

# --- Postgres directo (solo para `manage.py migrar_sql`) --------------------
# La API no usa esto: habla con Supabase por REST. Lo necesita únicamente el
# runner de migraciones, que abre una conexión SQL real.
#
# Copia los valores del dashboard: Project Settings -> Database ->
# Connection string -> pestaña "Session pooler". Usa el pooler y NO
# db.<ref>.supabase.co, porque ese host solo publica IPv6 y desde una red sin
# IPv6 da timeout. Ojo al usuario: es postgres.<project-ref>, no postgres.
SUPABASE_DB_HOST=aws-0-us-east-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.tu-project-ref
# Si se deja vacía, migrar_sql la pide por teclado y no se guarda en disco.
SUPABASE_DB_PASSWORD=

# --- Servidor ---------------------------------------------------------------
# Puerto en el que escucha runserver. Siempre en 127.0.0.1 (ver manage.py).
# En macOS no usar el 5000: lo ocupa el receptor de AirPlay (ControlCenter).
PORT=5001

# Clave de firma de Django. Si se omite se genera una efímera en cada arranque,
# lo cual es seguro pero invalida cualquier firma entre reinicios.
DJANGO_SECRET_KEY=

# Mantener en false salvo depuración: en true Django devuelve trazas completas.
DJANGO_DEBUG=false

# Hosts aceptados. Ampliar esta lista es lo que permitiría servir la API a otras
# máquinas; por defecto sólo loopback.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]

# --- Frontend ---------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Autenticación ----------------------------------------------------------
# Segundos que se memoiza la validación de un token contra Supabase. 0 desactiva
# la caché (una llamada de red por petición, revocación inmediata).
AUTH_CACHE_SECONDS=60

# En true exige token también para leer el catálogo de cursos y el contenido de
# las lecciones. En false (por defecto) ese contenido es público, igual que en
# el backend Node.
PYGO_REQUIRE_AUTH_FOR_CONTENT=false

# Zona horaria del servidor.
TIME_ZONE=UTC
